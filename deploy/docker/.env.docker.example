# APM Master - Docker Compose Environment Settings Template
# Copy this file to '.env.docker' and modify for local Docker Stack overrides.

# ── Container Names ───────────────────────────────────────────────────────────
KAFKA_CONTAINER_NAME=apm-kafka
POSTGRES_CONTAINER_NAME=apm-postgres
REDIS_CONTAINER_NAME=apm-redis
APP_MODE=all

# ── Host Ports (Mapped to container ports) ────────────────────────────────────
# Published ports bind to BIND_ADDR (loopback by default): reachable from this
# machine only. Do not use 0.0.0.0 on a shared or public network.
BIND_ADDR=127.0.0.1
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# ── TimescaleDB / Postgres Connection Credentials ─────────────────────────────
POSTGRES_USER=apm_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=apm_db

# ── Apache Kafka Broker Configurations ────────────────────────────────────────
KAFKA_NODE_ID=1
KAFKA_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_ADVERTISED_HOST=localhost

# ── Redis Authentication ──────────────────────────────────────────────────────
# Empty: no password (development only, loopback-bound). Set it to require a
# password; the application's REDIS_URL must then be
# redis://:<password>@redis:6379/0 (or @localhost:6379/0 from the host).
REDIS_PASSWORD=
