# APM Master - Environment Configuration Sample
# Copy this file to '.env' and modify for local deployment settings.

# ── General Settings ──────────────────────────────────────────────────────────
APP_ENV=development
APP_MODE=all
LOG_LEVEL=info
APP_URL=http://localhost:3000
HTTP_PORT=8080
# Browser origins allowed by CORS (comma-separated). Defaults to APP_URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Apply migrations at startup. Defaults to true only when APP_ENV=development;
# elsewhere run `migrate -action up` as a deploy step.
# AUTO_MIGRATE=true

# ── HTTP Server Timeouts (in Milliseconds) ────────────────────────────────────
HTTP_READ_TIMEOUT_MS=10000
HTTP_WRITE_TIMEOUT_MS=30000
HTTP_IDLE_TIMEOUT_MS=120000
HTTP_HEADER_TIMEOUT_MS=5000
MAX_BODY_BYTES=10485760 # 10MB

# ── TimescaleDB / Postgres Connection Settings ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=apm_user
POSTGRES_PASSWORD=
POSTGRES_DB=apm_db
POSTGRES_TIMEOUT_MS=5000

# ── Redis Connection Settings ───────────────────────────────────────────────
REDIS_URL=localhost:6379
REDIS_TIMEOUT_MS=5000

# ── Rate Limiting Settings ───────────────────────────────────────────────────
# RATE_LIMIT_BURST requests per RATE_LIMIT_WINDOW_MS, per client IP and per org.
RATE_LIMIT_BURST=200
RATE_LIMIT_WINDOW_MS=1000


# ── Security & Authentication Settings ───────────────────────────────────────
JWT_SECRET=your_super_secret_signing_key_for_jwts
ACCESS_TOKEN_EXPIRY_MINS=15
REFRESH_TOKEN_EXPIRY_DAYS=7
# Absolute session lifetime; refresh-token rotation never extends a session past it.
REFRESH_SESSION_MAX_DAYS=30
INVITE_EXPIRY_DAYS=10
PASSWORD_RESET_EXPIRY_MINS=30
# Ignore further reset requests for an account this long after a link was sent (0 = off).
PASSWORD_RESET_COOLDOWN_SECS=60

# ── Email & SMTP Configuration (Notifications) ────────────────────────────────
EMAIL_FROM=no-reply@apm-master.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Apache Kafka Broker & Ingestion Settings ──────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=apm-master-ingest
KAFKA_CONSUMER_GROUP=apm-master-ingest-writers

# Kafka Signal Topics
KAFKA_TRACES_TOPIC=apm.telemetry.traces.v1
KAFKA_LOGS_TOPIC=apm.telemetry.logs.v1
KAFKA_METRICS_TOPIC=apm.telemetry.metrics.v1

# Kafka Dead-Letter Queue (DLQ) Topics
KAFKA_TRACES_DLQ_TOPIC=apm.telemetry.traces.dlq.v1
KAFKA_LOGS_DLQ_TOPIC=apm.telemetry.logs.dlq.v1
KAFKA_METRICS_DLQ_TOPIC=apm.telemetry.metrics.dlq.v1

# Topic Parameters (Evaluated during auto-creation)
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000 # 7 days
KAFKA_COMPRESSION=lz4

# Ingest Buffers & Producer Sizing
KAFKA_PRODUCER_BATCH_SIZE=1000
KAFKA_PRODUCER_BATCH_BYTES=1048576 # 1MB
KAFKA_PRODUCER_BATCH_TIMEOUT_MS=10
KAFKA_PRODUCER_WRITE_TIMEOUT_MS=10000
KAFKA_PRODUCER_REQUIRED_ACKS=-1 # All replica acks
KAFKA_PRODUCER_MAX_ATTEMPTS=10

# consumer workers & persistence batch thresholds
KAFKA_CONSUMER_WORKERS=3
KAFKA_CONSUMER_BATCH_RECORDS=1000
KAFKA_CONSUMER_BATCH_BYTES=4194304 # 4MB
KAFKA_CONSUMER_FLUSH_INTERVAL_MS=1000
KAFKA_CONSUMER_READ_MAX_BYTES=10485760 # 10MB
KAFKA_CONSUMER_MAX_ATTEMPTS=5
KAFKA_CONSUMER_RETRY_INITIAL_MS=250
KAFKA_CONSUMER_RETRY_MAX_MS=5000

# ── Alert Evaluation Settings ────────────────────────────────────────────────
ALERT_EVALUATION_INTERVAL_MS=60000 # 1 minute evaluation ticker

# ── Retention (tables outside Timescale retention policies) ──────────────────
NOTIFICATION_RETENTION_DAYS=90
REFRESH_TOKEN_RETENTION_DAYS=30

# ── AI Investigations (apm-ai-service) ───────────────────────────────────────
KAFKA_AI_INVESTIGATION_TOPIC=ai.investigation.jobs
KAFKA_AI_RETRY_TOPIC=ai.investigation.retry
KAFKA_AI_DLQ_TOPIC=ai.investigation.dlq
# Shared secret apm-ai-service sends on /internal/v1 calls. The example value
# is rejected when APP_ENV is not development.
AI_SERVICE_TOKEN=apm-ai-secret-token-change-in-production
INVESTIGATION_OUTBOX_POLL_INTERVAL_MS=2000
INVESTIGATION_OUTBOX_BATCH_SIZE=50
